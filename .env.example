# =============================================================================
# CrashSense Telematics Environment Configuration Template
# Copy this file to .env before customizing. Do NOT commit production secrets.
# =============================================================================

# Server Network Configuration
PORT=3000
HOST=127.0.0.1

# Telematics & Detection Threshold Tuning
ACCEL_MAGNITUDE_THRESHOLD_G=3.2
ACCEL_JERK_THRESHOLD_G_PER_S=18.0
GYRO_MAGNITUDE_THRESHOLD_DEG_S=150.0
TILT_CHANGE_THRESHOLD_DEG=45.0
POST_IMPACT_STATIONARY_WINDOW_MS=2000

# Emergency Dispatch & Safety Parameters
# WARNING: Use only authorized development test phone numbers.
# Never configure public emergency numbers (911/112).
DEFAULT_EMERGENCY_RECIPIENT="+15550192834"
CANCELLATION_TIMEOUT_SEC=15
DEDUPLICATION_COOLDOWN_SEC=60
TEST_MODE_ACTIVE=true

# GNSS / GPS Default Coordinates (San Francisco Test Center)
GPS_DEFAULT_LAT=37.774929
GPS_DEFAULT_LNG=-122.419416
GPS_STALE_THRESHOLD_SEC=60

# Cellular Modem Configuration
MODEM_PORT="COM5"
MODEM_BAUD=115200
MODEM_RETRY_LIMIT=3
CELLULAR_OPERATOR="MockTel 4G LTE"

# Storage & Logging
LOG_JSONL_PATH="./logs/incidents.jsonl"
LOG_CSV_PATH="./logs/incidents.csv"
LOG_RETENTION_MAX_ENTRIES=500
